[Unit]
Description=EDUMind MiApp Training Worker (User Service)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/edumind_miapp/backend
EnvironmentFile=/var/www/edumind_miapp/backend/.env
ExecStart=/var/www/edumind_miapp/backend/.venv/bin/python /var/www/edumind_miapp/backend/scripts/training_worker.py --worker-id user-worker-1 --poll-interval 3
Restart=always
RestartSec=2
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
